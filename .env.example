# Copy to .env (git-ignored). Local values only — never put real secrets here.

# --- Design tooling (topic 02) ---
FAL_KEY=

# --- Local stack (docker-compose.yml; localhost only, X16) ---
POSTGRES_USER=gugu
POSTGRES_PASSWORD=gugu
POSTGRES_DB=gugu
POSTGRES_PORT=15432
REDIS_PORT=16379
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MAILPIT_SMTP_PORT=11025
MAILPIT_UI_PORT=18025

# --- API (apps/api) ---
NODE_ENV=development
API_PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgresql://gugu:gugu@127.0.0.1:15432/gugu
# Integration tests run against this database (created by infra/docker/postgres/init).
TEST_DATABASE_URL=postgresql://gugu:gugu@127.0.0.1:15432/gugu_test
REDIS_URL=redis://127.0.0.1:16379
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=ap-southeast-1
S3_BUCKET=gugu-media
S3_ACCESS_KEY_ID=gugu
S3_SECRET_ACCESS_KEY=gugu-local-secret
S3_FORCE_PATH_STYLE=true
SMTP_URL=smtp://127.0.0.1:11025
MAIL_FROM=GuGu <no-reply@gugu.local>

# --- Auth (topic 05). AUTH_SECRET: any random ≥32 chars locally; required in production. ---
# AUTH_SECRET=
# --- Admin TOTP (topic 05 step 9). MFA_ENCRYPTION_KEY: random ≥32 chars; required in production. ---
# MFA_ENCRYPTION_KEY=
# --- Analytics (X14, ADR-0018). ANALYTICS_HASH_SECRET salts actor hashes; random ≥32 chars; required in production. ---
# ANALYTICS_HASH_SECRET=
# ANALYTICS_RETENTION_MONTHS=24
# --- Email-only signup abuse brake: salons created per rolling 24 h (ADR-0018). ---
# QUICK_START_DAILY_CAP=500
# QUICK_START_DOMAIN_DAILY_LIMIT=20
# Per-user limits on /api/v1/admin/* per minute (defaults 240 requests / 30 writes).
# ADMIN_RATE_LIMIT_PER_MINUTE=240
# ADMIN_WRITE_RATE_LIMIT_PER_MINUTE=30
# Audit log retention in months (q94: 24; minimum 12, enforced by the DB trigger too).
# AUDIT_RETENTION_MONTHS=24
# --- Bookings (topic 06). BOOKING_TOKEN_SECRET: random ≥32 chars; required in production. ---
# BOOKING_TOKEN_SECRET=
WEB_APP_URL=http://localhost:8097
# Express trust proxy: false locally; 1 behind one load balancer/Cloudflare hop (topic 13).
TRUST_PROXY=false
WEB_ORIGINS=http://localhost:8097,http://localhost:8081
# Apple/Google sign-in stay disabled until client IDs are set (docs/domains/auth-security.md).
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
ZALO_LOGIN_ENABLED=false
# Several services per appointment (booking.multiService, topic 06 M6.8). On by default in every
# environment (q91); set to false to switch it off.
# BOOKING_MULTI_SERVICE=false

# AI import / assistant (topic 08). Leave empty locally unless you test with a real key:
# without it the AI import shows "not configured" and tests use a recorded client.
ANTHROPIC_API_KEY=
AI_USD_TO_VND=26000

# --- Zalo OA integration (topic 09, X24). Default outside production: built-in emulator. ---
# API_PUBLIC_URL=http://localhost:3001   # OAuth callback, emulator pages, webhook target
# ZALO_CLIENT=emulated                   # emulated | http | disabled (production default: disabled)
# ZALO_APP_ID=                           # http only (developers.zalo.me app)
# ZALO_APP_SECRET=
# ZALO_OA_SECRET_KEY=                    # webhook signing key from the Zalo app console (≥16)
# ZALO_TOKEN_KEY=                        # ≥32 random chars; encrypts OA tokens at rest
# ZALO_PRICE_TEMPLATE_VND=200            # indicative prices for the send log
# ZALO_PRICE_CS_PAID_VND=55
# ZALO_SUSPENDED_NOTICE_COOLDOWN_HOURS=24 # suspended salon: neutral bot notice at most once per chat per N h

# GuGu support contact shown to salon members (suspension banner, q89). Set per environment.
# SUPPORT_EMAIL=support@gugu.local
# SUPPORT_PHONE=0901 234 567

# Marketplace launch (topic 12 R-FP1, founding partners). Unset = not launched yet.
# MARKETPLACE_LAUNCH_AT=2027-06-01T00:00:00Z

# Prisma shadow database (migrate dev, db:drift).
SHADOW_DATABASE_URL=postgresql://gugu:gugu@127.0.0.1:15432/gugu_shadow
