{
  "name": "@gugu/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "prisma generate && prisma generate --config prisma/spike/prisma.config.ts",
    "build": "rolldown -c rolldown.config.ts",
    "dev": "node scripts/dev.mjs",
    "start": "node --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
    "start:worker": "node --enable-source-maps --env-file-if-exists=../../.env dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:drift": "node scripts/db-drift.mjs",
    "spike:s0": "node scripts/spike-s0.mjs"
  },
  "dependencies": {
    "@gugu/contracts": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "6.5.3",
    "express": "5.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@gugu/config": "workspace:*",
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.21",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "rolldown": "1.2.16",
    "supertest": "7.3.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
