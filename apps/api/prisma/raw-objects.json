{
  "$comment": "Database objects Prisma cannot see. `pnpm db:drift` fails if any is missing. Keep in sync with docs/domains/backend-database.md#raw-sql-objects.",
  "extensions": [
    "postgis",
    "btree_gist",
    "pg_trgm",
    "unaccent",
    "citext",
    "pgcrypto"
  ],
  "constraints": [
    "subscriptions_trial_ends_when_trialing",
    "plan_prices_amount_non_negative",
    "locations_parent_by_level",
    "magic_link_tokens_attempts_range",
    "salon_opening_hours_valid",
    "salon_holidays_valid",
    "staff_schedules_valid",
    "staff_breaks_valid",
    "staff_time_off_valid",
    "services_amounts_valid",
    "service_variants_amounts_valid",
    "service_addons_amounts_valid",
    "booking_occupancy_no_staff_overlap",
    "booking_occupancy_valid",
    "bookings_valid",
    "booking_services_valid",
    "offline_sales_amount_valid"
  ],
  "indexes": [
    "subscriptions_one_current_per_salon",
    "salon_members_one_owner",
    "staff_time_off_period_gix",
    "staff_profiles_one_per_member",
    "staff_services_unique_service",
    "staff_services_unique_variant",
    "outbox_events_unpublished"
  ],
  "triggers": [
    "audit_logs_no_update_delete",
    "booking_status_history_no_update_delete"
  ]
}
