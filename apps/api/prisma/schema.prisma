// GuGu data model — schema-of-record for ordinary columns. Everything Prisma cannot model (PostGIS
// columns' indexes, EXCLUDE/CHECK constraints, partial indexes, RLS, partitions) lives in hand-edited
// migration SQL and in prisma/raw-objects.json (ADR-0008, skill `prisma-migration`).
// Hot file: one task at a time (ownership map).

generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

// ─── Subscriptions & entitlements (topic 12, M12.1; docs/domains/monetization-admin.md) ─────────
// Commercial access is resolved per salon from plan entitlements + overrides. Plans and their
// entitlements are reference data inserted by migrations (mirrored in
// src/modules/subscriptions/domain/plan-catalog.ts; an integration test keeps both in sync).
// salon_id → salons(id) FKs added by topic 05 (migration add_subscription_salon_fks).

enum PlanBillingInterval {
  month
  year

  @@map("plan_billing_interval")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
  expired

  @@map("subscription_status")
}

enum BillingMode {
  manual

  @@map("billing_mode")
}

enum InvoicingEntity {
  tbd
  pl
  vn

  @@map("invoicing_entity")
}

model Plan {
  id            String            @id @default(uuid(7)) @db.Uuid
  /// Stable code: basic | pro | ultra (public) | trial (internal). Clients translate `plans.<code>.*`.
  code          String            @unique
  isPublic      Boolean           @map("is_public")
  /// Bumped whenever the plan's entitlements change (new migration).
  version       Int               @default(1)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  prices        PlanPrice[]
  entitlements  PlanEntitlement[]
  subscriptions Subscription[]

  @@map("plans")
}

/// Display prices (no processor in MVP). Amount in minor units of `currency` (VND has none).
model PlanPrice {
  id          String              @id @default(uuid(7)) @db.Uuid
  planId      String              @map("plan_id") @db.Uuid
  interval    PlanBillingInterval
  amountMinor BigInt              @map("amount_minor")
  currency    String              @default("VND") @db.Char(3)
  activeFrom  DateTime            @map("active_from") @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  plan        Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([planId, interval, activeFrom])
  @@map("plan_prices")
}

/// One value per (plan, entitlement key). `value` is validated against the key registry in
/// @gugu/contracts (boolean, or a non-negative integer / "unlimited" for limits).
model PlanEntitlement {
  id        String   @id @default(uuid(7)) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([planId, key])
  @@map("plan_entitlements")
}

/// A salon's subscription. At most one current (trialing | active | past_due) per salon — enforced
/// by the partial unique index `subscriptions_one_current_per_salon` (raw SQL).
model Subscription {
  id                 String               @id @default(uuid(7)) @db.Uuid
  salonId            String               @map("salon_id") @db.Uuid
  planId             String               @map("plan_id") @db.Uuid
  planVersion        Int                  @map("plan_version")
  status             SubscriptionStatus
  /// Null while trialing (no billing interval chosen yet).
  interval           PlanBillingInterval?
  billingMode        BillingMode          @default(manual) @map("billing_mode")
  invoicingEntity    InvoicingEntity      @default(tbd) @map("invoicing_entity")
  trialEndsAt        DateTime?            @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodStart DateTime?            @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime?            @map("current_period_end") @db.Timestamptz(6)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  plan               Plan                 @relation(fields: [planId], references: [id], onDelete: Restrict)
  salon              Salon                @relation(fields: [salonId], references: [id], onDelete: Restrict)
  events             SubscriptionEvent[]

  @@unique([salonId, id])
  @@index([salonId])
  @@map("subscriptions")
}

/// Append-only status history: every transition records previous/new status, actor and reason.
model SubscriptionEvent {
  id             String              @id @default(uuid(7)) @db.Uuid
  salonId        String              @map("salon_id") @db.Uuid
  subscriptionId String              @map("subscription_id") @db.Uuid
  fromStatus     SubscriptionStatus? @map("from_status")
  toStatus       SubscriptionStatus  @map("to_status")
  /// `user:<id>` | `system` | `admin:<id>` (topic 05 actor model).
  actor          String
  reason         String?
  occurredAt     DateTime            @default(now()) @map("occurred_at") @db.Timestamptz(6)
  subscription   Subscription        @relation(fields: [salonId, subscriptionId], references: [salonId, id], onDelete: Restrict)
  salon          Salon               @relation(fields: [salonId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, occurredAt])
  @@map("subscription_events")
}

/// Admin grant/restriction of one entitlement for one salon (pilots, support). Takes precedence over
/// the plan while active (not revoked, not expired).
model EntitlementOverride {
  id        String    @id @default(uuid(7)) @db.Uuid
  salonId   String    @map("salon_id") @db.Uuid
  key       String
  value     Json
  reason    String
  createdBy String    @map("created_by")
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  salon     Salon     @relation(fields: [salonId], references: [id], onDelete: Restrict)

  @@unique([salonId, id])
  @@index([salonId, key])
  @@map("entitlement_overrides")
}

// ─── Identity & users (module auth; spec 04 §3.2, spec 05 §3.1–3.2) ─────────────────────────────

enum UserStatus {
  active
  suspended
  pending_deletion
  deleted

  @@map("user_status")
}

enum PlatformRole {
  support_admin
  super_admin

  @@map("platform_role")
}

enum Locale {
  vi
  en

  @@map("locale")
}

model User {
  id                   String        @id @default(uuid(7)) @db.Uuid
  /// Normalised lower-case; citext keeps uniqueness case-insensitive.
  email                String?       @unique @db.Citext
  emailVerifiedAt      DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  /// E.164. Not verified for now (X12: no SMS); nullable after anonymisation.
  phoneE164            String?       @unique @map("phone_e164")
  status               UserStatus    @default(active)
  preferredLocale      Locale        @default(vi) @map("preferred_locale")
  platformRole         PlatformRole? @map("platform_role")
  lastLoginAt          DateTime?     @map("last_login_at") @db.Timestamptz(6)
  deletionRequestedAt  DateTime?     @map("deletion_requested_at") @db.Timestamptz(6)
  /// requested + 30 days (q39).
  deletionScheduledFor DateTime?     @map("deletion_scheduled_for") @db.Timestamptz(6)
  deletedAt            DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile             UserProfile?
  customer            Customer?
  identities          AuthIdentity[]
  sessions            Session[]
  magicLinks          MagicLinkToken[]
  salonMemberships    SalonMember[]        @relation("SalonMemberUser")
  invitedMembers      SalonMember[]        @relation("SalonMemberInvitedBy")
  orgMemberships      OrganizationMember[]
  ownedOrganizations  Organization[]
  ownedSalons         Salon[]
  approvedTimeOff     StaffTimeOff[]       @relation("StaffTimeOffApprovedBy")
  sentInvitations     SalonInvitation[]    @relation("SalonInvitationInvitedBy")
  acceptedInvitations SalonInvitation[]    @relation("SalonInvitationAcceptedBy")

  @@map("users")
}

model UserProfile {
  id                  String   @id @default(uuid(7)) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  displayName         String?  @map("display_name")
  /// FK to media_assets is added by the media milestone (04-S6).
  avatarMediaId       String?  @map("avatar_media_id") @db.Uuid
  preferredLocationId String?  @map("preferred_location_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  preferredLocation Location? @relation(fields: [preferredLocationId], references: [id], onDelete: Restrict)

  @@map("user_profiles")
}

/// Customer-specific data, separate from staff identity (spec 04 §3.2). Created on first sign-in.
model Customer {
  id                 String    @id @default(uuid(7)) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  marketingConsentAt DateTime? @map("marketing_consent_at") @db.Timestamptz(6)
  /// Schema owned by topic 11.
  notificationPrefs  Json      @default("{}") @map("notification_prefs")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("customers")
}

enum AuthProvider {
  apple
  google
  zalo

  @@map("auth_provider")
}

/// External sign-in identities. Linked only to a signed-in user or after proving the email (R5).
model AuthIdentity {
  id        String       @id @default(uuid(7)) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  provider  AuthProvider
  subject   String
  email     String?      @db.Citext
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, subject])
  @@index([userId])
  @@map("auth_identities")
}

enum SessionKind {
  web
  native

  @@map("session_kind")
}

/// One sign-in = one session = one refresh-token family (spec 05 R8). `token_hash` is the hash of
/// the web cookie secret or of the current native access token (rotated on refresh).
model Session {
  id             String      @id @default(uuid(7)) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  kind           SessionKind
  tokenHash      String      @unique @map("token_hash")
  /// Web: sliding expiry of the cookie. Native: expiry of the current access token.
  tokenExpiresAt DateTime    @map("token_expires_at") @db.Timestamptz(6)
  /// Absolute end of the session (90 days); never extended.
  expiresAt      DateTime    @map("expires_at") @db.Timestamptz(6)
  lastSeenAt     DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt      DateTime?   @map("revoked_at") @db.Timestamptz(6)
  revokeReason   String?     @map("revoke_reason")
  userAgent      String?     @map("user_agent")
  /// /24 (IPv4) or /48 (IPv6) prefix only.
  ipPrefix       String?     @map("ip_prefix")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

/// Native refresh tokens. Each use marks `used_at` and issues a successor; presenting a used token
/// again revokes the whole session (reuse detection, spec 05 G4).
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

enum MagicLinkPurpose {
  sign_in
  salon_registration

  @@map("magic_link_purpose")
}

/// Email magic links (link token + 6-digit code for typing on another device/app). Only HMACs are
/// stored; single use; 15-minute TTL; max 5 code attempts (spec 05 R2).
model MagicLinkToken {
  id           String           @id @default(uuid(7)) @db.Uuid
  email        String           @db.Citext
  userId       String?          @map("user_id") @db.Uuid
  purpose      MagicLinkPurpose @default(sign_in)
  tokenHash    String           @unique @map("token_hash")
  codeHash     String           @map("code_hash")
  attempts     Int              @default(0)
  client       SessionKind      @default(web)
  locale       Locale           @default(vi)
  redirectPath String?          @map("redirect_path")
  /// salon_registration: the salon whose pending owner membership this link activates.
  salonId      String?          @map("salon_id") @db.Uuid
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime?        @map("consumed_at") @db.Timestamptz(6)
  ipPrefix     String?          @map("ip_prefix")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User?  @relation(fields: [userId], references: [id], onDelete: Restrict)
  salon Salon? @relation(fields: [salonId], references: [id], onDelete: Restrict)

  @@index([email, createdAt])
  @@map("magic_link_tokens")
}

// ─── Locations & categories (stubs until 10-locations / 04-S4 catalog) ─────────────────────────

enum LocationLevel {
  province
  ward

  @@map("location_level")
}

/// Vietnamese administrative units after the 2025 reform (province → ward; no district level).
/// Database-managed (master §7); this milestone seeds a small stub set.
model Location {
  id        String        @id @default(uuid(7)) @db.Uuid
  level     LocationLevel
  code      String        @unique
  parentId  String?       @map("parent_id") @db.Uuid
  nameVi    String        @map("name_vi")
  nameEn    String        @map("name_en")
  slug      String
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent         Location?       @relation("LocationParent", fields: [parentId], references: [id], onDelete: Restrict)
  children       Location[]      @relation("LocationParent")
  profiles       UserProfile[]
  salonProvinces SalonLocation[] @relation("SalonLocationProvince")
  salonWards     SalonLocation[] @relation("SalonLocationWard")

  @@index([parentId])
  @@index([level])
  @@map("locations")
}

/// Global, admin-managed service categories (master §7). Seeded with the initial ten.
model ServiceCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  slug      String   @unique
  /// LocalizedText `{ "vi": "...", "en": "..." }`.
  name      Json
  icon      String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   ServiceCategory?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Restrict)
  children ServiceCategory[] @relation("CategoryParent")
  salons   Salon[]
  services Service[]

  @@map("service_categories")
}

// ─── Organisations & salons (spec 04 §3.2; owner answer q19) ────────────────────────────────────

enum OrganizationStatus {
  active
  suspended
  closed

  @@map("organization_status")
}

enum OrganizationRole {
  org_owner
  org_manager
  org_viewer

  @@map("organization_role")
}

enum MemberStatus {
  invited
  pending_verification
  active
  removed

  @@map("member_status")
}

model Organization {
  id            String             @id @default(uuid(7)) @db.Uuid
  name          String
  slug          String             @unique @db.Citext
  ownerUserId   String             @map("owner_user_id") @db.Uuid
  status        OrganizationStatus @default(active)
  defaultLocale Locale             @default(vi) @map("default_locale")
  currency      String             @default("VND") @db.Char(3)
  /// Hint from registration ("1" | "2+") until chains onboarding exists.
  locationsHint String?            @map("locations_hint")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner   User                 @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  salons  Salon[]
  members OrganizationMember[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  status         MemberStatus     @default(active)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

enum SalonStatus {
  draft
  pending_review
  active
  suspended
  closed

  @@map("salon_status")
}

/// One salon = one bookable location = the tenant (`salon_id` row scope).
model Salon {
  id                String      @id @default(uuid(7)) @db.Uuid
  organizationId    String      @map("organization_id") @db.Uuid
  slug              String      @unique @db.Citext
  name              String
  status            SalonStatus @default(draft)
  verifiedAt        DateTime?   @map("verified_at") @db.Timestamptz(6)
  timezone          String      @default("Asia/Ho_Chi_Minh")
  defaultLocale     Locale      @default(vi) @map("default_locale")
  currency          String      @default("VND") @db.Char(3)
  ownerUserId       String      @map("owner_user_id") @db.Uuid
  phoneE164         String?     @map("phone_e164")
  primaryCategoryId String?     @map("primary_category_id") @db.Uuid
  deletedAt         DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner                User                  @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  primaryCategory      ServiceCategory?      @relation(fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  location             SalonLocation?
  members              SalonMember[]
  magicLinks           MagicLinkToken[]
  subscriptions        Subscription[]
  subscriptionEvents   SubscriptionEvent[]
  entitlementOverrides EntitlementOverride[]
  settings             SalonSettings?
  openingHours         SalonOpeningHours[]
  holidays             SalonHoliday[]
  staffProfiles        StaffProfile[]
  services             Service[]
  invitations          SalonInvitation[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("salons")
}

model SalonLocation {
  id          String                                @id @default(uuid(7)) @db.Uuid
  salonId     String                                @unique @map("salon_id") @db.Uuid
  addressLine String                                @map("address_line")
  wardId      String                                @map("ward_id") @db.Uuid
  provinceId  String                                @map("province_id") @db.Uuid
  geo         Unsupported("geography(Point,4326)")?
  mapPlaceId  String?                               @map("map_place_id")
  isPrimary   Boolean                               @default(true) @map("is_primary")
  createdAt   DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon    Salon    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  ward     Location @relation("SalonLocationWard", fields: [wardId], references: [id], onDelete: Restrict)
  province Location @relation("SalonLocationProvince", fields: [provinceId], references: [id], onDelete: Restrict)

  @@unique([salonId, id])
  @@index([geo], type: Gist)
  @@map("salon_locations")
}

enum SalonRole {
  owner
  manager
  receptionist
  staff

  @@map("salon_role")
}

model SalonMember {
  id                  String       @id @default(uuid(7)) @db.Uuid
  salonId             String       @map("salon_id") @db.Uuid
  userId              String       @map("user_id") @db.Uuid
  role                SalonRole
  /// `{ "grant": [...], "revoke": [...] }` — see packages/domain/src/auth/permissions.ts.
  permissionsOverride Json?        @map("permissions_override")
  status              MemberStatus @default(active)
  invitedById         String?      @map("invited_by_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon         Salon          @relation(fields: [salonId], references: [id], onDelete: Restrict)
  user          User           @relation("SalonMemberUser", fields: [userId], references: [id], onDelete: Restrict)
  invitedBy     User?          @relation("SalonMemberInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  staffProfiles StaffProfile[]

  @@unique([salonId, userId])
  @@unique([salonId, id])
  @@index([userId])
  @@map("salon_members")
}

// ─── Audit (spec 05 §3.7) ───────────────────────────────────────────────────────────────────────

enum ActorType {
  anonymous
  user
  agent
  integration
  system
  platform_admin

  @@map("actor_type")
}

/// Append-only: a trigger rejects UPDATE and DELETE (raw SQL, migration add_identity_tenancy).
/// metadata never contains secrets, tokens, codes or personal data.
model AuditLog {
  id             String    @id @default(uuid(7)) @db.Uuid
  actorType      ActorType @map("actor_type")
  actorId        String?   @map("actor_id") @db.Uuid
  salonId        String?   @map("salon_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  action         String
  targetType     String?   @map("target_type")
  targetId       String?   @map("target_id") @db.Uuid
  requestId      String?   @map("request_id")
  ipPrefix       String?   @map("ip_prefix")
  userAgent      String?   @map("user_agent")
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([salonId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ─── Salon settings, hours, holidays (topic 07 M7.5; spec 04 §3.2, 06 §3.1) ─────────────────────

enum ConfirmationMode {
  auto
  manual

  @@map("confirmation_mode")
}

/// Booking and policy settings (1:1 with salon). Read by the booking engine (06).
model SalonSettings {
  id                        String           @id @default(uuid(7)) @db.Uuid
  salonId                   String           @unique @map("salon_id") @db.Uuid
  bookingWindowDays         Int              @default(60) @map("booking_window_days")
  minLeadTimeMinutes        Int              @default(60) @map("min_lead_time_minutes")
  cancellationCutoffMinutes Int              @default(120) @map("cancellation_cutoff_minutes")
  rescheduleCutoffMinutes   Int              @default(120) @map("reschedule_cutoff_minutes")
  /// q13: per-salon auto/manual; manual bookings expire after `manualConfirmWindowHours`.
  confirmationMode          ConfirmationMode @default(auto) @map("confirmation_mode")
  manualConfirmWindowHours  Int              @default(12) @map("manual_confirm_window_hours")
  /// q66: confirm first-time/unverified clients manually (off by default).
  confirmNewClients         Boolean          @default(false) @map("confirm_new_clients")
  /// q18: salons may hide staff choice from customers.
  hideStaffChoice           Boolean          @default(false) @map("hide_staff_choice")
  maxActiveBookingsPerPhone Int              @default(3) @map("max_active_bookings_per_phone")
  slotGranularityMinutes    Int              @default(15) @map("slot_granularity_minutes")
  /// Booking hold lifetime while a customer confirms (06).
  holdTtlMinutes            Int              @default(7) @map("hold_ttl_minutes")
  reminderOffsets           Int[]            @default([1440, 120]) @map("reminder_offsets")
  /// LocalizedText `{ vi, en }` (either may be empty).
  description               Json?
  bookingPolicy             Json?            @map("booking_policy")
  cancellationPolicy        Json?            @map("cancellation_policy")
  /// Bumped on every schedule/hours/catalog change; availability cache key (06 G19).
  availabilityVersion       Int              @default(0) @map("availability_version")
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Restrict)

  @@unique([salonId, id])
  @@map("salon_settings")
}

/// Weekly opening hours (salon wall-clock). Several rows per weekday allowed (split shifts).
model SalonOpeningHours {
  id        String   @id @default(uuid(7)) @db.Uuid
  salonId   String   @map("salon_id") @db.Uuid
  /// ISO weekday 1 = Monday … 7 = Sunday.
  weekday   Int      @db.SmallInt
  opensAt   DateTime @map("opens_at") @db.Time(0)
  closesAt  DateTime @map("closes_at") @db.Time(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Restrict)

  @@unique([salonId, id])
  @@index([salonId, weekday])
  @@map("salon_opening_hours")
}

/// Closed days or special hours for a date range (inclusive, salon-local dates).
model SalonHoliday {
  id        String    @id @default(uuid(7)) @db.Uuid
  salonId   String    @map("salon_id") @db.Uuid
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  closed    Boolean   @default(true)
  opensAt   DateTime? @map("opens_at") @db.Time(0)
  closesAt  DateTime? @map("closes_at") @db.Time(0)
  reason    String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Restrict)

  @@unique([salonId, id])
  @@index([salonId, startDate])
  @@map("salon_holidays")
}

// ─── Staff (topic 07 M7.4; spec 04 §3.2 "Staff") ────────────────────────────────────────────────

/// A bookable person. May exist before the person has an account (salon_member_id null).
model StaffProfile {
  id            String    @id @default(uuid(7)) @db.Uuid
  salonId       String    @map("salon_id") @db.Uuid
  salonMemberId String?   @map("salon_member_id") @db.Uuid
  displayName   String    @map("display_name")
  /// LocalizedText.
  bio           Json?
  /// Calendar colour key (design-system tone), not a hex value.
  color         String    @default("lilac")
  isBookable    Boolean   @default(true) @map("is_bookable")
  sortOrder     Int       @default(0) @map("sort_order")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon       Salon             @relation(fields: [salonId], references: [id], onDelete: Restrict)
  member      SalonMember?      @relation(fields: [salonId, salonMemberId], references: [salonId, id], onDelete: Restrict)
  schedules   StaffSchedule[]
  breaks      StaffBreak[]
  timeOff     StaffTimeOff[]
  services    StaffService[]
  invitations SalonInvitation[]

  @@unique([salonId, id])
  @@index([salonId, sortOrder])
  @@map("staff_profiles")
}

/// Weekly working hours (salon wall-clock), valid from `effectiveFrom` until `effectiveTo` (inclusive).
model StaffSchedule {
  id            String    @id @default(uuid(7)) @db.Uuid
  salonId       String    @map("salon_id") @db.Uuid
  staffId       String    @map("staff_id") @db.Uuid
  weekday       Int       @db.SmallInt
  startsAt      DateTime  @map("starts_at") @db.Time(0)
  endsAt        DateTime  @map("ends_at") @db.Time(0)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  staff StaffProfile @relation(fields: [salonId, staffId], references: [salonId, id], onDelete: Restrict)

  @@unique([salonId, id])
  @@index([salonId, staffId, weekday])
  @@map("staff_schedules")
}

/// Recurring (weekday) or one-day (date) break; exactly one of the two is set (CHECK).
model StaffBreak {
  id        String    @id @default(uuid(7)) @db.Uuid
  salonId   String    @map("salon_id") @db.Uuid
  staffId   String    @map("staff_id") @db.Uuid
  weekday   Int?      @db.SmallInt
  date      DateTime? @db.Date
  startsAt  DateTime  @map("starts_at") @db.Time(0)
  endsAt    DateTime  @map("ends_at") @db.Time(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  staff StaffProfile @relation(fields: [salonId, staffId], references: [salonId, id], onDelete: Restrict)

  @@unique([salonId, id])
  @@index([salonId, staffId])
  @@map("staff_breaks")
}

/// Absence as a UTC range [starts_at, ends_at). Engine queries use `tstzrange(starts_at, ends_at)`
/// (GiST expression index `staff_time_off_period_gix`, raw SQL).
model StaffTimeOff {
  id               String   @id @default(uuid(7)) @db.Uuid
  salonId          String   @map("salon_id") @db.Uuid
  staffId          String   @map("staff_id") @db.Uuid
  startsAt         DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime @map("ends_at") @db.Timestamptz(6)
  reason           String?
  approvedByUserId String?  @map("approved_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  staff      StaffProfile @relation(fields: [salonId, staffId], references: [salonId, id], onDelete: Restrict)
  approvedBy User?        @relation("StaffTimeOffApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@unique([salonId, id])
  @@index([salonId, staffId, startsAt])
  @@map("staff_time_off")
}

/// Staff ↔ service assignment with optional per-staff overrides (06 G13 resolution order).
model StaffService {
  id                      String   @id @default(uuid(7)) @db.Uuid
  salonId                 String   @map("salon_id") @db.Uuid
  staffId                 String   @map("staff_id") @db.Uuid
  serviceId               String   @map("service_id") @db.Uuid
  variantId               String?  @map("variant_id") @db.Uuid
  priceOverrideMinor      BigInt?  @map("price_override_minor")
  durationOverrideMinutes Int?     @map("duration_override_minutes")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  staff   StaffProfile    @relation(fields: [salonId, staffId], references: [salonId, id], onDelete: Restrict)
  service Service         @relation(fields: [salonId, serviceId], references: [salonId, id], onDelete: Restrict)
  variant ServiceVariant? @relation(fields: [salonId, variantId], references: [salonId, id], onDelete: Restrict)

  @@unique([salonId, id])
  @@index([salonId, serviceId])
  @@map("staff_services")
}

// ─── Catalog (topic 07 M7.4; spec 04 §3.2 "Catalog", 06 §3.12) ───────────────────────────────────

model Service {
  id                  String    @id @default(uuid(7)) @db.Uuid
  salonId             String    @map("salon_id") @db.Uuid
  categoryId          String?   @map("category_id") @db.Uuid
  /// LocalizedText `{ vi, en }` — vi required.
  name                Json
  description         Json?
  priceAmountMinor    BigInt    @map("price_amount_minor")
  priceMaxAmountMinor BigInt?   @map("price_max_amount_minor")
  currency            String    @default("VND") @db.Char(3)
  durationMinutes     Int       @map("duration_minutes")
  bufferBeforeMinutes Int       @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes  Int       @default(0) @map("buffer_after_minutes")
  isActive            Boolean   @default(true) @map("is_active")
  sortOrder           Int       @default(0) @map("sort_order")
  /// Schema owned by the booking engine (06).
  bookingRestrictions Json?     @map("booking_restrictions")
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon    Salon            @relation(fields: [salonId], references: [id], onDelete: Restrict)
  category ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ServiceVariant[]
  addOns   ServiceAddOn[]
  staff    StaffService[]

  @@unique([salonId, id])
  @@index([salonId, sortOrder])
  @@map("services")
}

model ServiceVariant {
  id                  String    @id @default(uuid(7)) @db.Uuid
  salonId             String    @map("salon_id") @db.Uuid
  serviceId           String    @map("service_id") @db.Uuid
  name                Json
  priceAmountMinor    BigInt?   @map("price_amount_minor")
  priceMaxAmountMinor BigInt?   @map("price_max_amount_minor")
  durationMinutes     Int?      @map("duration_minutes")
  sortOrder           Int       @default(0) @map("sort_order")
  isActive            Boolean   @default(true) @map("is_active")
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  service Service        @relation(fields: [salonId, serviceId], references: [salonId, id], onDelete: Restrict)
  staff   StaffService[]

  @@unique([salonId, id])
  @@index([salonId, serviceId])
  @@map("service_variants")
}

/// Optional extra on one service (q17): extra duration + price, performed in the same block.
model ServiceAddOn {
  id                       String    @id @default(uuid(7)) @db.Uuid
  salonId                  String    @map("salon_id") @db.Uuid
  serviceId                String    @map("service_id") @db.Uuid
  name                     Json
  extraDurationMinutes     Int       @default(0) @map("extra_duration_minutes")
  extraPriceAmountMinor    BigInt    @default(0) @map("extra_price_amount_minor")
  extraPriceMaxAmountMinor BigInt?   @map("extra_price_max_amount_minor")
  currency                 String    @default("VND") @db.Char(3)
  maxQuantity              Int       @default(1) @map("max_quantity")
  sortOrder                Int       @default(0) @map("sort_order")
  isActive                 Boolean   @default(true) @map("is_active")
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  service Service @relation(fields: [salonId, serviceId], references: [salonId, id], onDelete: Restrict)

  @@unique([salonId, id])
  @@index([salonId, serviceId])
  @@map("service_addons")
}

// ─── Team invitations (topic 07 minimal flow; spec 05 R6 — 05 may take ownership later) ──────────

/// Single-use, 72 h staff invitation. Only the HMAC of the token is stored. When `email` is set,
/// only a signed-in user with that verified email can accept.
model SalonInvitation {
  id               String    @id @default(uuid(7)) @db.Uuid
  salonId          String    @map("salon_id") @db.Uuid
  role             SalonRole
  email            String?   @db.Citext
  staffProfileId   String?   @map("staff_profile_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash")
  invitedById      String    @map("invited_by_id") @db.Uuid
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedByUserId String?   @map("accepted_by_user_id") @db.Uuid
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Restrict)
  staffProfile StaffProfile? @relation(fields: [salonId, staffProfileId], references: [salonId, id], onDelete: Restrict)
  invitedBy    User          @relation("SalonInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?         @relation("SalonInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@unique([salonId, id])
  @@index([salonId, createdAt])
  @@map("salon_invitations")
}
