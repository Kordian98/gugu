}

// ---------------------------------------------------------------------------------------------
// Zalo (topic 09, roadmap X24): salon-owned OA connection, booking chatbot, inbox, sends.
// Spec: docs/tasks/09-zalo.md · domain doc: docs/domains/zalo.md.
// ---------------------------------------------------------------------------------------------

enum ZaloConnectionStatus {
  connected
  /// Token refresh failed or the OA revoked access; the owner must reconnect.
  needs_reauth
  /// Disconnected by the salon: no messages are sent or processed.
  disconnected

  @@map("zalo_connection_status")
}

/// One salon ↔ one Zalo Official Account. Tokens are AES-256-GCM encrypted (ZALO_TOKEN_KEY).
model ZaloOaConnection {
  id                  String               @id @default(uuid(7)) @db.Uuid
  salonId             String               @unique @map("salon_id") @db.Uuid
  /// Zalo OA id. Unique while connected (partial index), so one OA serves one salon.
  oaId                String               @map("oa_id")
  oaName              String               @map("oa_name")
  status              ZaloConnectionStatus @default(connected)
  accessTokenEnc      String?              @map("access_token_enc")
  refreshTokenEnc     String?              @map("refresh_token_enc")
  accessExpiresAt     DateTime?            @map("access_expires_at") @db.Timestamptz(6)
  /// Rule-based booking bot answers customers (X24). Off = every chat goes to staff.
  botEnabled          Boolean              @default(true) @map("bot_enabled")
  /// Reminder toggles (q40: on by default).
  reminder24h         Boolean              @default(true) @map("reminder_24h")
  reminder2h          Boolean              @default(true) @map("reminder_2h")
  /// Allow paid consultation messages (48 h – 7 d after the customer's last message).
  allowPaidMessages   Boolean              @default(true) @map("allow_paid_messages")
  /// ZBS template ids approved for this OA: `{ "booking_confirmation": "…", "booking_reminder": "…" }`.
  templateIds         Json                 @default("{}") @map("template_ids")
  /// Owner-set monthly cap on template messages (null = plan limit only).
  monthlyTemplateCap  Int?                 @map("monthly_template_cap")
  /// Hand a staff-mode chat back to the bot after this many minutes without staff activity (0 = never).
  staffReleaseMinutes Int                  @default(30) @map("staff_release_minutes")
  connectedByUserId   String               @map("connected_by_user_id") @db.Uuid
  connectedAt         DateTime             @default(now()) @map("connected_at") @db.Timestamptz(6)
  disconnectedAt      DateTime?            @map("disconnected_at") @db.Timestamptz(6)
  lastRefreshAt       DateTime?            @map("last_refresh_at") @db.Timestamptz(6)
  lastError           String?              @map("last_error")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Restrict)

  @@unique([salonId, id])
  @@index([oaId])
  @@map("zalo_oa_connections")
}

enum ZaloConversationMode {
  /// The booking bot answers.
  bot
  /// A staff member took over; the bot stays silent until released.
  staff

  @@map("zalo_conversation_mode")
}

/// One Zalo user of one salon OA. Records belong to that salon only (X21/X24: no shared accounts).
model ZaloConversation {
  id                    String               @id @default(uuid(7)) @db.Uuid
  salonId               String               @map("salon_id") @db.Uuid
  oaId                  String               @map("oa_id")
  /// Zalo user id — scoped to the OA by Zalo, never a phone number.
  zaloUserId            String               @map("zalo_user_id")
  displayName           String?              @map("display_name")
  /// Shared by the customer (request-info form or typed); E.164.
  phoneE164             String?              @map("phone_e164")
  mode                  ZaloConversationMode @default(bot)
  /// Booking bot state (see modules/zalo/domain/bot).
  botState              Json                 @default("{}") @map("bot_state")
  assignedUserId        String?              @map("assigned_user_id") @db.Uuid
  handoffRequestedAt    DateTime?            @map("handoff_requested_at") @db.Timestamptz(6)
  /// Last hand-off, take-over or staff reply: drives the auto-release back to the bot.
  lastStaffActivityAt   DateTime?            @map("last_staff_activity_at") @db.Timestamptz(6)
  /// When the customer was last told "a staff member will reply" (once per staff period).
  staffNoticeAt         DateTime?            @map("staff_notice_at") @db.Timestamptz(6)
  /// Last message/click/follow from the customer — drives the 48 h / 7 d send window.
  lastUserInteractionAt DateTime?            @map("last_user_interaction_at") @db.Timestamptz(6)
  lastMessageAt         DateTime?            @map("last_message_at") @db.Timestamptz(6)
  unreadCount           Int                  @default(0) @map("unread_count")
  followedAt            DateTime?            @map("followed_at") @db.Timestamptz(6)
  unfollowedAt          DateTime?            @map("unfollowed_at") @db.Timestamptz(6)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon        Salon             @relation(fields: [salonId], references: [id], onDelete: Restrict)
  messages     ZaloMessage[]
  bookingLinks ZaloBookingLink[]
  funnelEvents ZaloFunnelEvent[]

  @@unique([oaId, zaloUserId])
  @@unique([salonId, id])
  @@index([salonId, lastMessageAt])
  @@index([salonId, phoneE164])
  @@map("zalo_conversations")
}

enum ZaloMessageDirection {
  inbound
  outbound

  @@map("zalo_message_direction")
}

enum ZaloMessageSender {
  customer
  bot
  staff
  system

  @@map("zalo_message_sender")
}

/// Chat history shown in the panel. Customer text is personal data: never sent to an LLM (X10).
model ZaloMessage {
  id             String               @id @default(uuid(7)) @db.Uuid
  salonId        String               @map("salon_id") @db.Uuid
  conversationId String               @map("conversation_id") @db.Uuid
  direction      ZaloMessageDirection
  sender         ZaloMessageSender
  staffUserId    String?              @map("staff_user_id") @db.Uuid
  /// text | image | sticker | file | location | button | user_info | template | follow | unfollow
  kind           String
  text           String?
  /// Buttons offered (outbound) or the hidden payload clicked (inbound).
  payload        Json?
  zaloMessageId  String?              @map("zalo_message_id")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation ZaloConversation @relation(fields: [salonId, conversationId], references: [salonId, id], onDelete: Restrict)

  @@unique([salonId, id])
  @@index([conversationId, createdAt])
  @@map("zalo_messages")
}

/// Idempotent store of verified webhook events (one row per Zalo event).
model ZaloWebhookEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  /// msg_id when Zalo sends one, else a hash of app/oa/user/event/timestamp.
  eventKey    String    @unique @map("event_key")
  oaId        String    @map("oa_id")
  salonId     String?   @map("salon_id") @db.Uuid
  eventName   String    @map("event_name")
  /// received | processed | ignored | failed
  status      String    @default("received")
  error       String?
  /// Raw Zalo payload; purged after 30 days (contains customer text).
  payload     Json
  occurredAt  DateTime  @map("occurred_at") @db.Timestamptz(6)
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  @@index([status, receivedAt])
  @@map("zalo_webhook_events")
}

enum ZaloSendStatus {
  queued
  sent
  failed
  /// Not sent on purpose: window closed, quota reached, disconnected, no phone.
  rejected

  @@map("zalo_send_status")
}

/// Every outbound Zalo send with status and estimated cost (X24).
model ZaloSendLog {
  id              String         @id @default(uuid(7)) @db.Uuid
  salonId         String         @map("salon_id") @db.Uuid
  conversationId  String?        @map("conversation_id") @db.Uuid
  bookingId       String?        @map("booking_id") @db.Uuid
  messageId       String?        @map("message_id") @db.Uuid
  /// cs (consultation message) | template (ZBS Template Message, channel id zalo_template)
  channel         String
  /// bot_reply | staff_reply | booking_confirmation | reminder_24h | reminder_2h | booking_update
  purpose         String
  /// free (≤ 48 h) | paid (48 h – 7 d) | template
  tier            String?
  /// Unique per logical message, so retries and re-scans never send twice.
  dedupKey        String         @unique @map("dedup_key")
  status          ZaloSendStatus @default(queued)
  costEstimateVnd Int            @default(0) @map("cost_estimate_vnd")
  attempts        Int            @default(0)
  zaloMessageId   String?        @map("zalo_message_id")
  errorCode       String?        @map("error_code")
  /// Outbound content to send (buttons, template data); cleared to {} once sent.
  request         Json           @default("{}")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt          DateTime?      @map("sent_at") @db.Timestamptz(6)

  @@index([salonId, createdAt])
  @@index([salonId, channel, status, createdAt])
  @@map("zalo_send_logs")
}

/// Booking made in (or linked to) a Zalo conversation: drives reminders and in-chat actions.
model ZaloBookingLink {
  bookingId           String    @id @map("booking_id") @db.Uuid
  salonId             String    @map("salon_id") @db.Uuid
  conversationId      String    @map("conversation_id") @db.Uuid
  customerConfirmedAt DateTime? @map("customer_confirmed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  booking      Booking          @relation(fields: [salonId, bookingId], references: [salonId, id], onDelete: Restrict)
  conversation ZaloConversation @relation(fields: [salonId, conversationId], references: [salonId, id], onDelete: Restrict)

  @@unique([salonId, bookingId])
  @@index([conversationId])
  @@map("zalo_booking_links")
}

/// Things staff should look at in the Zalo panel (hand-off requests, bot booking changes).
model ZaloStaffNotification {
  id             String    @id @default(uuid(7)) @db.Uuid
  salonId        String    @map("salon_id") @db.Uuid
  /// handoff_requested | booking_created | booking_cancelled | booking_rescheduled | booking_confirmed | connection_needs_reauth
  kind           String
  conversationId String?   @map("conversation_id") @db.Uuid
  bookingId      String?   @map("booking_id") @db.Uuid
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([salonId, createdAt])
  @@map("zalo_staff_notifications")
}

// ---------------------------------------------------------------------------------------------
// AI business assistant (topic 08 A1/A2). Model-facing content is stored tokenized: no names,
// phones, emails or free text about people (PII firewall, spec 08 §4.3). Domain doc:
// docs/domains/ai-agent.md.
// ---------------------------------------------------------------------------------------------

enum AssistantToolCallStatus {
  ok
  withheld
  forbidden
  error

  @@map("assistant_tool_call_status")
}

/// One chat thread of one salon member. Deleting it removes its messages and token map.
model AssistantConversation {
  id        String    @id @default(uuid(7)) @db.Uuid
  salonId   String    @map("salon_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  locale    String    @default("vi")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  salon     Salon                  @relation(fields: [salonId], references: [id], onDelete: Restrict)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages  AssistantMessage[]
  tokens    AssistantEntityToken[]
  toolCalls AssistantToolCall[]

  @@unique([salonId, id])
  @@index([salonId, userId, updatedAt])
  @@map("assistant_conversations")
}

/// Model-facing message (tokenized), stored exactly as sent/returned so the harness stays append-only.
model AssistantMessage {
  id               String   @id @default(uuid(7)) @db.Uuid
  salonId          String   @map("salon_id") @db.Uuid
  conversationId   String   @map("conversation_id") @db.Uuid
  role             String
  content          Json
  model            String?
  inputTokens      Int      @default(0) @map("input_tokens")
  outputTokens     Int      @default(0) @map("output_tokens")
  cacheReadTokens  Int      @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int      @default(0) @map("cache_write_tokens")
  costVnd          Int      @default(0) @map("cost_vnd")
  stopReason       String?  @map("stop_reason")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation AssistantConversation @relation(fields: [salonId, conversationId], references: [salonId, id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}

/// Per-conversation pseudonym (`staff_3`) → entity id. Never a name.
model AssistantEntityToken {
  id             String   @id @default(uuid(7)) @db.Uuid
  salonId        String   @map("salon_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  token          String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation AssistantConversation @relation(fields: [salonId, conversationId], references: [salonId, id], onDelete: Cascade)

  @@unique([conversationId, token])
  @@unique([conversationId, entityType, entityId])
  @@map("assistant_entity_tokens")
}

/// Audit of every tool call: inputs are tokens/enums/dates; outputs only as a digest.
model AssistantToolCall {
  id             String                  @id @default(uuid(7)) @db.Uuid
  salonId        String                  @map("salon_id") @db.Uuid
  conversationId String                  @map("conversation_id") @db.Uuid
  toolName       String                  @map("tool_name")
  input          Json
  status         AssistantToolCallStatus
  outputDigest   String?                 @map("output_digest")
  latencyMs      Int                     @map("latency_ms")
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation AssistantConversation @relation(fields: [salonId, conversationId], references: [salonId, id], onDelete: Cascade)

  @@index([salonId, createdAt])
  @@map("assistant_tool_calls")
}

// ─── Customers CRM (topic 07 M7.7; spec 04 CustomerSalonProfile, 07 §3.5/§4.4) ───────────────────

/// Per-salon view of a client: name, tags, consent and internal notes. Visit statistics are read
/// from bookings (by phone) at query time, so they never drift. Created when a salon adds a client,
/// or materialised from bookings the first time the directory sees that phone.
model CustomerSalonProfile {
  id               String    @id @default(uuid(7)) @db.Uuid
  salonId          String    @map("salon_id") @db.Uuid
  phoneE164        String?   @map("phone_e164")
  displayName      String    @map("display_name")
  customerUserId   String?   @map("customer_user_id") @db.Uuid
  tags             String[]  @default([])
  /// `{ "zalo": bool, "email": bool, "sms": bool }` — marketing consent per channel.
  marketingConsent Json      @default("{}") @map("marketing_consent")
  source           String    @default("booking")
  mergedIntoId     String?   @map("merged_into_id") @db.Uuid
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon Salon          @relation(fields: [salonId], references: [id], onDelete: Restrict)
  notes CustomerNote[]

  @@unique([salonId, id])
  @@index([salonId, displayName])
  @@map("customer_salon_profiles")
}

/// Internal note about a client. Team-only: never serialised in any customer-facing response.
model CustomerNote {
  id           String    @id @default(uuid(7)) @db.Uuid
  salonId      String    @map("salon_id") @db.Uuid
  profileId    String    @map("profile_id") @db.Uuid
  authorUserId String    @map("author_user_id") @db.Uuid
  body         String
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  profile CustomerSalonProfile @relation(fields: [salonId, profileId], references: [salonId, id], onDelete: Restrict)
  author  User                 @relation("CustomerNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@unique([salonId, id])
  @@index([salonId, profileId, createdAt])
  @@map("customer_notes")
}

// ─── Resources (topic 06 M6.6; spec 06 §3.4, X4) ────────────────────────────────────────────────
// A resource of capacity N has N resource_units; units are claimed in booking_occupancy under the
// EXCLUDE constraint `booking_occupancy_no_unit_overlap`, so capacity is never counted.

/// Salon-defined kind of resource ("Giường massage", "Ghế pedicure", "Phòng VIP").
model ResourceType {
  id        String    @id @default(uuid(7)) @db.Uuid
  salonId   String    @map("salon_id") @db.Uuid
  name      String
  sortOrder Int       @default(0) @map("sort_order")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon        Salon                        @relation(fields: [salonId], references: [id], onDelete: Restrict)
  resources    Resource[]
  requirements ServiceResourceRequirement[]

  @@unique([salonId, id])
  @@index([salonId, sortOrder])
  @@map("resource_types")
}

/// One room/chair/bed/device (or a group of identical ones: capacity = active units).
model Resource {
  id             String    @id @default(uuid(7)) @db.Uuid
  salonId        String    @map("salon_id") @db.Uuid
  resourceTypeId String    @map("resource_type_id") @db.Uuid
  name           String
  isActive       Boolean   @default(true) @map("is_active")
  sortOrder      Int       @default(0) @map("sort_order")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  type  ResourceType   @relation(fields: [salonId, resourceTypeId], references: [salonId, id], onDelete: Restrict)
  units ResourceUnit[]

  @@unique([salonId, id])
  @@index([salonId, resourceTypeId])
  @@map("resources")
}

/// One bookable capacity slot of a resource. Managed by the API (capacity changes), never deleted
/// while referenced by occupancy history — deactivated instead.
model ResourceUnit {
  id         String   @id @default(uuid(7)) @db.Uuid
  salonId    String   @map("salon_id") @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  /// 1-based position within the resource ("Giường 2").
  position   Int
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  resource  Resource           @relation(fields: [salonId, resourceId], references: [salonId, id], onDelete: Restrict)
  occupancy BookingOccupancy[]

  @@unique([salonId, id])
  @@unique([resourceId, position])
  @@map("resource_units")
}

/// A service needs `quantity` units of a resource type at the same time as the staff member.
model ServiceResourceRequirement {
  id             String   @id @default(uuid(7)) @db.Uuid
  salonId        String   @map("salon_id") @db.Uuid
  serviceId      String   @map("service_id") @db.Uuid
  resourceTypeId String   @map("resource_type_id") @db.Uuid
  quantity       Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  service Service      @relation(fields: [salonId, serviceId], references: [salonId, id], onDelete: Restrict)
  type    ResourceType @relation(fields: [salonId, resourceTypeId], references: [salonId, id], onDelete: Restrict)

  @@unique([salonId, id])
  @@unique([serviceId, resourceTypeId])
  @@map("service_resource_requirements")
}

/// Zalo bot funnel and activity events for statistics (owner request 2026-11-03). Append-only
/// (trigger). Counts and steps only: no message text, names or phones — the conversation id is a
/// pseudonymous key. Aggregated by modules/zalo/application/stats.queries.ts.
model ZaloFunnelEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  salonId        String   @map("salon_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  /// One booking attempt of the bot (service → … → booked / ended).
  sessionId      String?  @map("session_id") @db.Uuid
  /// See FUNNEL_EVENTS in modules/zalo/domain/funnel.ts.
  event          String
  /// service | staff | slot | phone | confirm
  step           String?
  /// Why a session ended without a booking, or why the bot could not answer.
  reason         String?
  bookingId      String?  @map("booking_id") @db.Uuid
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)

  conversation ZaloConversation @relation(fields: [salonId, conversationId], references: [salonId, id], onDelete: Restrict)

  @@index([salonId, occurredAt])
  @@index([salonId, sessionId])
  @@map("zalo_funnel_events")
}

// ─── Notifications (topic 11; docs/domains/customer-notifications.md) ───────────────────────────
// Customer emails (fallback after Zalo), staff in-app + email. Rows hold ids and codes only: the
// recipient address is resolved at send time, so the log never stores emails or message bodies.

enum NotificationDeliveryStatus {
  /// Reminder waiting for its time (delayed BullMQ job).
  scheduled
  queued
  sent
  /// Provider confirmed delivery (webhook; not wired for SMTP).
  delivered
  failed
  /// Not sent on purpose; `reason` says why (sent_via_zalo, no_email, disabled, stale, …).
  skipped

  @@map("notification_delivery_status")
}

enum NotificationAudience {
  customer
  team

  @@map("notification_audience")
}

/// Per-salon notification settings (1:1). Reminder offsets live in salon_settings.reminder_offsets.
model NotificationSettings {
  id           String   @id @default(uuid(7)) @db.Uuid
  salonId      String   @unique @map("salon_id") @db.Uuid
  /// `{ "<event>": { "<channel>": boolean } }`; a missing entry means the catalog default.
  events       Json     @default("{}")
  /// Replies to customer emails go here (the salon's own inbox).
  replyToEmail String?  @map("reply_to_email") @db.Citext
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Restrict)

  @@map("notification_settings")
}

/// One planned send (one recipient × channel × event × variant). Unique idempotency key =
/// sha256(event|entity|version|recipient|channel|variant), also the BullMQ job id.
model NotificationDelivery {
  id                String                     @id @default(uuid(7)) @db.Uuid
  salonId           String                     @map("salon_id") @db.Uuid
  bookingId         String?                    @map("booking_id") @db.Uuid
  conversationId    String?                    @map("conversation_id") @db.Uuid
  /// Notification event from the catalog, e.g. `booking.confirmed`, `salon.booking_cancelled`.
  event             String
  /// Reminder offset (`1440m`) or empty.
  variant           String                     @default("")
  audience          NotificationAudience
  /// Team member recipient (audience = team); customers have no account (X23).
  recipientUserId   String?                    @map("recipient_user_id") @db.Uuid
  /// email | in_app
  channel           String
  idempotencyKey    String                     @unique @map("idempotency_key")
  status            NotificationDeliveryStatus
  /// Skip/failure reason code.
  reason            String?
  /// Set when this send only goes out if the primary channel (zalo_template) did not deliver.
  fallbackOf        String?                    @map("fallback_of")
  locale            Locale                     @default(vi)
  scheduledFor      DateTime?                  @map("scheduled_for") @db.Timestamptz(6)
  /// Send lease: a crashed worker's claim expires and the retry may take over.
  lockedUntil       DateTime?                  @map("locked_until") @db.Timestamptz(6)
  attempts          Int                        @default(0)
  providerMessageId String?                    @map("provider_message_id")
  /// Billable units (1 per email) and estimated cost in VND (q33: tracked per salon).
  units             Int                        @default(0)
  costEstimateVnd   Int                        @default(0) @map("cost_estimate_vnd")
  /// Booking version the send was planned for (reminders: stale versions are dropped).
  entityVersion     Int?                       @map("entity_version")
  /// sha256 of the canonical customer address (abuse caps; never the address itself).
  recipientKey      String?                    @map("recipient_key")
  /// Quota reserved for this send (customer email caps count sent + reserved in-flight rows).
  reservedAt        DateTime?                  @map("reserved_at") @db.Timestamptz(6)
  /// Ids and codes only: source event id, Zalo dedup key, planned start.
  meta              Json                       @default("{}")
  sentAt            DateTime?                  @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([salonId, bookingId, createdAt])
  @@index([status, scheduledFor])
  @@index([salonId, createdAt])
  @@index([recipientKey, reservedAt])
  @@index([salonId, reservedAt])
  @@map("notification_deliveries")
}

/// Staff in-app inbox item (bell). Display data is joined at read time; nothing personal is copied.
model Notification {
  id             String    @id @default(uuid(7)) @db.Uuid
  salonId        String    @map("salon_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  event          String
  bookingId      String?   @map("booking_id") @db.Uuid
  conversationId String?   @map("conversation_id") @db.Uuid
  /// The delivery that created it (one inbox item per delivery).
  deliveryId     String    @unique @map("delivery_id") @db.Uuid
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([salonId, userId, createdAt])
  @@map("notifications")
}

/// A team member's own choice for this salon (email copies of team notifications).
model NotificationMemberPref {
  salonId      String   @map("salon_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  emailEnabled Boolean  @default(true) @map("email_enabled")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([salonId, userId])
  @@map("notification_member_prefs")
}
