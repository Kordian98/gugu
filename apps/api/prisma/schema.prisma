  method           OfflineSaleMethod @default(cash)
  note             String?
  recordedByUserId String            @map("recorded_by_user_id") @db.Uuid
  recordedAt       DateTime          @default(now()) @map("recorded_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking    Booking @relation(fields: [salonId, bookingId], references: [salonId, id], onDelete: Restrict)
  recordedBy User    @relation("OfflineSaleRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@unique([salonId, id])
  @@unique([salonId, bookingId])
  @@index([salonId, recordedAt])
