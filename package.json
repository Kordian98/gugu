{
  "name": "gugu",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @gugu/app web",
    "dev:api": "pnpm --filter @gugu/api dev",
    "dev:worker": "pnpm --filter @gugu/api dev:worker",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down",
    "stack:reset": "docker compose down --volumes",
    "db:migrate": "pnpm --filter @gugu/api db:migrate",
    "db:drift": "pnpm --filter @gugu/api db:drift",
    "test:integration": "pnpm --filter @gugu/api test:integration",
    "e2e:web": "pnpm --filter @gugu/e2e-web e2e",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "depcruise apps packages --config packages/config/dependency-cruiser.cjs",
    "secrets": "node scripts/secrets-scan.mjs",
    "agents:check": "node scripts/agents-check.mjs",
    "verify": "pnpm format:check && pnpm boundaries && pnpm secrets && pnpm agents:check && turbo run lint typecheck test"
  },
  "devDependencies": {
    "dependency-cruiser": "18.7.1",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "~6.0.3"
  }
}
